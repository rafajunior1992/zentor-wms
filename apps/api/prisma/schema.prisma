// =============================================================================
// WMS — Warehouse Management System
// Schema Prisma — PostgreSQL
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Papéis operacionais no galpão
enum UserRole {
  PICKER
  EXPEDITER
  REPLENISHER
  ADMIN
}

/// Tipo físico da localização no layout do armazém
enum LocationType {
  PICK_FACE // Gôndola de separação (frente de picking)
  PULMAO    // Estoque de reserva / reabastecimento
}

/// Ciclo de vida do pedido no WMS
enum OrderStatus {
  PENDING
  PICKING
  PAUSED_ISSUE
  PICKED_AWAITING_CONFERENCE
  PACKING_RETURNED_TO_PICKING
  DISPATCHING
  DISPATCHED
}

/// Eventos de cronometragem da operação (separação / expedição)
enum OrderTimeLogEvent {
  START
  PAUSE
  RESUME
  END
  PACK_START
  PACK_END
  PACK_CANCEL
  PACK_REPORT_ISSUE
  DISPATCH_START
  DISPATCH_END
}

/// Status da onda de separação
enum PickWaveStatus {
  DRAFT
  RELEASED
  CLOSED
}

/// Progresso do packing após pick consolidado
enum PickWaveLineSortStatus {
  PENDING
  PICKED
  SORTED
}

/// Tipos de movimentação de estoque (log imutável)
enum InventoryMovementType {
  ENTRY              // Entrada de mercadoria no armazém
  EXIT               // Saída definitiva (expedição, perda, etc.)
  TRANSFER           // Movimentação entre localizações (ex: PULMAO → PICK_FACE)
  ADJUSTMENT         // Ajuste de inventário (contagem, correção)
  PICK_ALLOCATION    // Reserva/baixa vinculada à separação de pedido
  REPLENISHMENT      // Reabastecimento de pick face a partir do pulmão
}

/// Status da conexão OAuth com Tiny ERP v3
enum TinyConnectionStatus {
  PENDING
  CONNECTED
  ERROR
  BLOCKED
}

/// Tipo de sessão no recebimento do caminhão
enum PurchaseReceiptKind {
  ENTRY   // NF de entrada (Tiny)
  RETURN  // Devolução de cliente
}

/// Status da sessão de recebimento/conferência de compra no WMS
enum PurchaseReceiptSessionStatus {
  WAITING_ENTRY
  READY_TO_CHECK
  IN_CHECK
  COMPLETED
  ISSUE
  CANCELLED
}

enum PutawaySessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/// Transporte de carga pulmão → gôndola (duas etapas)
enum CargoTransferStatus {
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

/// Aceite de reabastecimento (gôndola → operador)
enum ReplenishmentAssignmentStatus {
  OPEN
  WITHDRAWN
  COMPLETED
  CANCELLED
}

// -----------------------------------------------------------------------------
// Tenant (cliente / empresa)
// -----------------------------------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  cnpj      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  tinyConnections         TinyConnection[]
  products                Product[]
  locations               Location[]
  warehouseBarracoes      WarehouseBarracao[]
  warehouseSetores        WarehouseSetor[]
  warehouseCorredores     WarehouseCorredor[]
  warehouseEstantes       WarehouseEstante[]
  warehouseColunas        WarehouseColuna[]
  warehouseLinhas         WarehouseLinha[]
  baskets                 Basket[]
  orders                  Order[]
  pickWaves               PickWave[]
  purchaseReceiptSessions PurchaseReceiptSession[]
  inventoryMovements      InventoryMovement[]
  cargoTransfers          CargoTransfer[]
  replenishmentAssignments ReplenishmentAssignment[]
  integrationEventLogs    IntegrationEventLog[]
  systemSettings          SystemSetting[]
  locationProximityReferences LocationProximityReference[]

  @@map("tenants")
}

// -----------------------------------------------------------------------------
// User & Roles
// -----------------------------------------------------------------------------

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  password    String
  role        UserRole @default(PICKER)
  /// Permissões granulares do painel (chaves como web.access, users.manage)
  permissions String[] @default([])
  active      Boolean  @default(true)
  /// Super-admin da plataforma (sem tenant; gerencia clientes)
  isPlatformAdmin Boolean @default(false)
  /// Cliente ao qual o usuário pertence (null apenas para isPlatformAdmin)
  tenantId    String?
  /// URL da foto de perfil (opcional)
  avatarUrl   String?
  /// Token de integração Olist (por usuário)
  olistToken  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Pedidos atribuídos a este operador
  assignedOrders Order[] @relation("OrderAssignedPicker")

  /// Movimentações de estoque registradas por este usuário
  inventoryMovements InventoryMovement[]

  /// Eventos de tempo registrados por este usuário
  orderTimeLogs OrderTimeLog[]
  orderStageLogs OrderStageLog[]

  notifications Notification[]
  pushDevices   PushDevice[]
  releasedWaves PickWave[] @relation("WaveReleasedBy")
  acceptedWaves PickWave[] @relation("WaveAcceptedBy")
  waveLinesPicked     PickWaveLine[]     @relation("WaveLinePickedBy")
  waveAllocationsSorted PickWaveAllocation[] @relation("WaveAllocSortedBy")
  purchaseReceiptSessions PurchaseReceiptSession[] @relation("PurchaseReceiptStartedBy")
  purchaseReceiptTimeLogs PurchaseReceiptTimeLog[]
  putawaySessions         PutawaySession[]         @relation("PutawayAssignedTo")
  putawayTimeLogs         PutawayTimeLog[]
  cargoTransfersWithdrawn CargoTransfer[]          @relation("CargoTransferWithdrawnBy")
  cargoTransfersDeposited CargoTransfer[]          @relation("CargoTransferDepositedBy")
  replenishmentAssignments ReplenishmentAssignment[] @relation("ReplenishmentAssignedTo")
  tinyConnections          TinyConnection[]

  @@index([role])
  @@index([tenantId])
  @@map("users")
}

/// Notificações in-app e push para o usuário
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  /// ORDER | STOCK | SYSTEM | SHIPPING
  category  String    @default("SYSTEM")
  /// JSON com ids de pedido, sku, etc.
  data      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// Token de dispositivo para push (Expo / Web)
model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  /// expo | web
  platform  String
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, token])
  @@index([userId])
  @@map("push_devices")
}

/// Configurações por tenant (ondas, etc.)
model SystemSetting {
  tenantId    String
  key         String
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("system_settings")
}

// -----------------------------------------------------------------------------
// Product
// -----------------------------------------------------------------------------

model Product {
  id                String  @id @default(cuid())
  tenantId          String
  sku               String
  name              String
  /// Quando true, cada unidade deve ser bipada individualmente na separação.
  /// Quando false, o operador informa apenas a quantidade (ex: parafusos a granel).
  requiresItemScan  Boolean @default(false)
  barcode           String?
  /// URL da imagem do produto (packing / catálogo)
  imageUrl          String?
  /// Unidade de medida (UN, CX, KG, etc.)
  unit              String?
  /// Peso unitário em kg
  weight            Decimal? @db.Decimal(12, 4)
  /// Fornecedor principal (sincronizado do Tiny: fornecedores[].nome)
  supplierName      String?
  /// Saldo no ERP Tiny (estoque.quantidade) — referência, não é estoque WMS
  erpStockQuantity  Decimal? @db.Decimal(12, 4)
  /// Tipo no Tiny: K|S|V|F|M (Kit, Simples, Variações, Fabricado, Matéria Prima)
  tinyTipo          String?
  active            Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations         Location[]
  orderItems        OrderItem[]
  inventoryMovements InventoryMovement[]
  pickWaveLines     PickWaveLine[]
  cargoTransfers    CargoTransfer[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([sku])
  @@map("products")
}

// -----------------------------------------------------------------------------
// Layout do galpão (Gestão de barracão)
// -----------------------------------------------------------------------------

model WarehouseBarracao {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String?
  pickOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  setores   WarehouseSetor[]
  locations Location[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouse_barracoes")
}

model WarehouseSetor {
  id         String   @id @default(cuid())
  tenantId   String
  barracaoId String
  code       String
  name       String?
  pickOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  barracao   WarehouseBarracao   @relation(fields: [barracaoId], references: [id], onDelete: Cascade)
  corredores WarehouseCorredor[]
  locations  Location[]

  @@unique([tenantId, barracaoId, code])
  @@index([tenantId])
  @@index([barracaoId])
  @@map("warehouse_setores")
}

model WarehouseCorredor {
  id       String   @id @default(cuid())
  tenantId String
  setorId  String
  code     String
  name     String?
  pickOrder Int     @default(0)
  active   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  setor    WarehouseSetor    @relation(fields: [setorId], references: [id], onDelete: Cascade)
  estantes WarehouseEstante[]
  locations Location[]
  proximityLocations Location[] @relation("LocationProximityCorredor")
  proximityReferenceCorredor LocationProximityReference[] @relation("ProximityRefCorredor")

  @@unique([tenantId, setorId, code])
  @@index([tenantId])
  @@index([setorId])
  @@map("warehouse_corredores")
}

model WarehouseEstante {
  id         String   @id @default(cuid())
  tenantId   String
  corredorId String
  code       String
  name       String?
  pickOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  corredor  WarehouseCorredor   @relation(fields: [corredorId], references: [id], onDelete: Cascade)
  colunas   WarehouseColuna[]
  locations Location[]
  proximityLocations Location[] @relation("LocationProximityEstante")
  proximityReferenceEstante LocationProximityReference[] @relation("ProximityRefEstante")

  @@unique([tenantId, corredorId, code])
  @@index([tenantId])
  @@index([corredorId])
  @@map("warehouse_estantes")
}

model WarehouseColuna {
  id        String   @id @default(cuid())
  tenantId  String
  estanteId String
  code      String
  name      String?
  pickOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  estante   WarehouseEstante @relation(fields: [estanteId], references: [id], onDelete: Cascade)
  linhas    WarehouseLinha[]
  locations Location[]

  @@unique([tenantId, estanteId, code])
  @@index([tenantId])
  @@index([estanteId])
  @@map("warehouse_colunas")
}

model WarehouseLinha {
  id        String   @id @default(cuid())
  tenantId  String
  colunaId  String
  code      String
  name      String?
  pickOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coluna    WarehouseColuna  @relation(fields: [colunaId], references: [id], onDelete: Cascade)
  location  Location?
  proximityReferences Location[] @relation("LocationProximityLinha")
  proximityReferenceLinha LocationProximityReference[] @relation("ProximityRefLinha")

  @@unique([tenantId, colunaId, code])
  @@index([tenantId])
  @@index([colunaId])
  @@map("warehouse_linhas")
}

// -----------------------------------------------------------------------------
// Location (Gôndolas / Pulmão)
// -----------------------------------------------------------------------------

model Location {
  id              String       @id @default(cuid())
  tenantId        String
  /// Corredor do galpão (ex: "A", "B", "01")
  corridor        String
  /// Linha dentro do corredor (ex: "01", "02")
  row             String
  /// Código de barras físico da etiqueta da gôndola/pulmão
  barcode         String
  barracaoId      String?
  setorId         String?
  corredorId      String?
  estanteId           String?
  colunaId            String?
  linhaId             String?      @unique
  proximityCorredorId String?
  proximityEstanteId  String?
  proximityLinhaId    String?
  type                LocationType
  /// Produto alocado nesta posição (opcional — pulmão pode estar vazio ou em transição)
  productId       String?
  /// Quantidade física atual nesta localização
  currentQuantity Int          @default(0)
  /// Capacidade máxima da posição
  capacity        Int
  /// Limite mínimo para disparar alerta de reabastecimento
  minThreshold    Int          @default(0)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product    Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  barracao   WarehouseBarracao?  @relation(fields: [barracaoId], references: [id], onDelete: SetNull)
  setor      WarehouseSetor?     @relation(fields: [setorId], references: [id], onDelete: SetNull)
  corredor   WarehouseCorredor?  @relation(fields: [corredorId], references: [id], onDelete: SetNull)
  estante    WarehouseEstante?   @relation(fields: [estanteId], references: [id], onDelete: SetNull)
  coluna     WarehouseColuna?    @relation(fields: [colunaId], references: [id], onDelete: SetNull)
  linha      WarehouseLinha?     @relation(fields: [linhaId], references: [id], onDelete: SetNull)
  proximityCorredor WarehouseCorredor? @relation("LocationProximityCorredor", fields: [proximityCorredorId], references: [id], onDelete: SetNull)
  proximityEstante  WarehouseEstante?  @relation("LocationProximityEstante", fields: [proximityEstanteId], references: [id], onDelete: SetNull)
  proximityLinha      WarehouseLinha?    @relation("LocationProximityLinha", fields: [proximityLinhaId], references: [id], onDelete: SetNull)

  /// Itens de pedido com pick sugerido nesta localização
  orderItemsPickFrom OrderItem[] @relation("OrderItemPickLocation")

  /// Movimentações com esta localização como origem
  movementsFrom InventoryMovement[] @relation("MovementFromLocation")

  /// Movimentações com esta localização como destino
  movementsTo InventoryMovement[] @relation("MovementToLocation")

  pickWaveLines      PickWaveLine[]
  putawayItems       PutawayItem[]
  cargoTransfersFrom CargoTransfer[] @relation("CargoTransferFrom")
  cargoTransfersTo   CargoTransfer[] @relation("CargoTransferTo")
  cargoTransfersTarget CargoTransfer[] @relation("CargoTransferTargetFace")
  replenishmentAssignments ReplenishmentAssignment[]
  proximityReferenceRows LocationProximityReference[]

  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([corridor, row])
  @@index([type])
  @@index([productId])
  @@index([barracaoId])
  @@index([setorId])
  @@map("locations")
}

model LocationProximityReference {
  id                  String   @id @default(cuid())
  tenantId            String
  locationId          String
  sortOrder           Int      @default(0)
  proximityCorredorId String?
  proximityEstanteId  String?
  proximityLinhaId    String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location          Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  proximityCorredor WarehouseCorredor? @relation("ProximityRefCorredor", fields: [proximityCorredorId], references: [id], onDelete: SetNull)
  proximityEstante  WarehouseEstante?  @relation("ProximityRefEstante", fields: [proximityEstanteId], references: [id], onDelete: SetNull)
  proximityLinha    WarehouseLinha?    @relation("ProximityRefLinha", fields: [proximityLinhaId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([locationId])
  @@map("location_proximity_references")
}

// -----------------------------------------------------------------------------
// Basket / Tote (Cestas de Separação)
// -----------------------------------------------------------------------------

model Basket {
  id        String   @id @default(cuid())
  tenantId  String
  /// Identificador legível da cesta (ex: "CESTA-042")
  code      String
  /// Código de barras da cesta física
  barcode   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Pedidos atualmente vinculados a esta cesta durante a separação
  orders Order[]

  @@unique([tenantId, code])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@map("baskets")
}

// -----------------------------------------------------------------------------
// Order & OrderItem
// -----------------------------------------------------------------------------

model Order {
  id        String      @id @default(cuid())
  tenantId  String
  /// Identificador do pedido no ERP (chave de integração)
  erpOrderId String
  status    OrderStatus @default(PENDING)
  priority  Int         @default(0)
  /// Prioridade informada pelo ERP (Tiny), normalizada 0–100 quando disponível
  erpPriority Int?

  /// Cesta física atrelada durante a separação (opcional até o início do picking)
  basketId  String?
  /// Operador responsável pela separação/expedição
  assignedPickerId String?

  /// Metadados de integração ERP
  customerName  String?
  shippingLabel String?
  notes         String?
  /// Horário limite de coleta (ex.: Mercado Livre)
  collectionDeadline DateTime?
  /// Marketplace de origem (ex.: MERCADO_LIVRE)
  marketplace        String?
  /// Origem do pedido (TINY, MANUAL, etc.)
  erpSource          String?  @default("MANUAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Data/hora em que o pedido foi marcado como expedido
  dispatchedAt DateTime?

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  basket         Basket? @relation(fields: [basketId], references: [id], onDelete: SetNull)
  assignedPicker User?   @relation("OrderAssignedPicker", fields: [assignedPickerId], references: [id], onDelete: SetNull)

  items              OrderItem[]
  timeLogs           OrderTimeLog[]
  stageLogs          OrderStageLog[]
  inventoryMovements InventoryMovement[]
  waveOrders         PickWaveOrder[]

  @@unique([tenantId, erpOrderId])
  @@index([tenantId])
  @@index([status])
  @@index([tenantId, status])
  @@index([status, collectionDeadline, priority])
  @@index([dispatchedAt])
  @@index([basketId])
  @@index([assignedPickerId])
  @@index([tenantId, marketplace])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  /// Vazio quando o SKU do ERP ainda não existe no cadastro WMS
  productId String?
  /// SKU do ERP quando productId ainda não foi resolvido
  erpSku    String?
  /// Descrição do item no ERP (quando productId ausente)
  erpDescription String?
  /// Número da linha no pedido ERP
  lineNumber Int

  quantityOrdered Int @default(0)
  quantityPicked  Int @default(0)
  quantityPacked  Int @default(0)

  /// Localização sugerida para o pick (pick face alocado ao produto)
  pickLocationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  pickLocation Location? @relation("OrderItemPickLocation", fields: [pickLocationId], references: [id], onDelete: SetNull)
  waveAllocations PickWaveAllocation[]

  @@unique([orderId, lineNumber])
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// -----------------------------------------------------------------------------
// InventoryMovement — log imutável de estoque
// -----------------------------------------------------------------------------

model InventoryMovement {
  id        String   @id @default(cuid())
  tenantId  String
  createdAt DateTime @default(now())

  type      InventoryMovementType
  quantity  Int

  userId    String
  productId String

  /// Localização de origem (nulo em entradas externas)
  fromLocationId String?
  /// Localização de destino (nulo em saídas definitivas)
  toLocationId   String?

  /// Pedido relacionado (quando a movimentação é parte da separação)
  orderId String?

  /// Referência externa (NF, lote, motivo do ajuste)
  reference String?
  notes     String?

  cargoTransferId          String?
  putawaySessionId         String?
  purchaseReceiptSessionId String?
  pickWaveLineId           String?
  startedAt                DateTime?
  completedAt              DateTime?

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromLocation Location? @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location? @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cargoTransfer CargoTransfer? @relation(fields: [cargoTransferId], references: [id], onDelete: SetNull)
  putawaySession PutawaySession? @relation(fields: [putawaySessionId], references: [id], onDelete: SetNull)
  purchaseReceiptSession PurchaseReceiptSession? @relation(fields: [purchaseReceiptSessionId], references: [id], onDelete: SetNull)
  pickWaveLine PickWaveLine? @relation(fields: [pickWaveLineId], references: [id], onDelete: SetNull)
  withdrawForCargoTransfer CargoTransfer? @relation("CargoWithdrawMovement")
  depositForCargoTransfer  CargoTransfer? @relation("CargoDepositMovement")

  @@index([tenantId])
  @@index([createdAt])
  @@index([productId])
  @@index([userId])
  @@index([orderId])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([cargoTransferId])
  @@map("inventory_movements")
}

// -----------------------------------------------------------------------------
// CargoTransfer — transporte de carga (pulmão → trânsito → gôndola)
// -----------------------------------------------------------------------------

model CargoTransfer {
  id        String              @id @default(cuid())
  tenantId  String
  status    CargoTransferStatus @default(IN_TRANSIT)
  productId String
  quantity  Int

  fromLocationId String
  toLocationId   String?
  targetPickFaceId String?

  withdrawnById String
  withdrawnAt   DateTime @default(now())
  depositedById String?
  depositedAt   DateTime?

  withdrawMovementId String? @unique
  depositMovementId  String? @unique

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  fromLocation   Location  @relation("CargoTransferFrom", fields: [fromLocationId], references: [id], onDelete: Restrict)
  toLocation     Location? @relation("CargoTransferTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  targetPickFace Location? @relation("CargoTransferTargetFace", fields: [targetPickFaceId], references: [id], onDelete: SetNull)
  withdrawnBy    User      @relation("CargoTransferWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: Restrict)
  depositedBy    User?     @relation("CargoTransferDepositedBy", fields: [depositedById], references: [id], onDelete: SetNull)
  withdrawMovement InventoryMovement? @relation("CargoWithdrawMovement", fields: [withdrawMovementId], references: [id], onDelete: SetNull)
  depositMovement  InventoryMovement? @relation("CargoDepositMovement", fields: [depositMovementId], references: [id], onDelete: SetNull)
  movements        InventoryMovement[]
  replenishmentAssignment ReplenishmentAssignment?

  @@index([tenantId, status])
  @@index([withdrawnById])
  @@map("cargo_transfers")
}

// -----------------------------------------------------------------------------
// OrderTimeLog — cronometragem de operação
// -----------------------------------------------------------------------------

model OrderTimeLog {
  id        String            @id @default(cuid())
  orderId   String
  userId    String
  event     OrderTimeLogEvent
  /// Motivo opcional (ex: PAUSE por falta de estoque, divergência)
  reason    String?
  createdAt DateTime          @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([userId])
  @@map("order_time_logs")
}

// -----------------------------------------------------------------------------
// OrderStageLog — trilha de transições de status do pedido
// -----------------------------------------------------------------------------

model OrderStageLog {
  id         String       @id @default(cuid())
  tenantId   String
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  userId     String?
  /// Motivo opcional (JSON para devolução do packing, texto para pausa)
  reason     String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, toStatus, createdAt])
  @@index([orderId, createdAt])
  @@map("order_stage_logs")
}

// -----------------------------------------------------------------------------
// Pick Wave — separação em onda
// -----------------------------------------------------------------------------

model PickWave {
  id                 String         @id @default(cuid())
  tenantId           String
  name               String
  status             PickWaveStatus @default(DRAFT)
  marketplace        String?
  partitionStrategy  String?
  releasedAt         DateTime?
  releasedById       String?
  acceptedById       String?
  acceptedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  releasedBy User?  @relation("WaveReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)
  acceptedBy User?  @relation("WaveAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  orders     PickWaveOrder[]
  lines      PickWaveLine[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([status])
  @@index([releasedAt])
  @@index([acceptedById])
  @@map("pick_waves")
}

// -----------------------------------------------------------------------------
// Tiny ERP — OAuth v3 (uma ou mais contas por usuário)
// -----------------------------------------------------------------------------

model TinyConnection {
  id                String               @id @default(cuid())
  tenantId          String
  userId            String
  name              String               @default("Tiny ERP")
  /// Conta padrão do usuário para sync e chamadas à API
  isDefault         Boolean              @default(false)
  apiVersion        String               @default("v3")
  status            TinyConnectionStatus @default(PENDING)
  oauthClientId     String?
  oauthClientSecret String?
  oauthRedirectUri  String?
  accessToken       String?
  refreshToken      String?
  oauthIdToken      String?
  tokenExpiresAt    DateTime?
  companyName       String?
  metadata          Json?
  lastValidatedAt   DateTime?
  lastError         String?
  isActive          Boolean              @default(true)
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, userId])
  @@index([status])
  @@map("tiny_connections")
}

// -----------------------------------------------------------------------------
// Recebimento / conferência de compra (NF entrada via Tiny)
// -----------------------------------------------------------------------------

model PurchaseReceiptSession {
  id              String                       @id @default(cuid())
  tenantId        String
  kind            PurchaseReceiptKind          @default(ENTRY)
  tinyNotaId      Int?
  accessKey       String?
  invoiceNumber   String?
  supplierName    String?
  /// Referência manual (ex.: pedido devolvido)
  reference       String?
  status          PurchaseReceiptSessionStatus @default(READY_TO_CHECK)
  tinySyncStatus  String?
  tinySyncMessage String?
  startedById          String
  startedAt            DateTime                     @default(now())
  conferenceStartedAt  DateTime?
  conferenceEndedAt    DateTime?
  completedAt          DateTime?
  updatedAt            DateTime                     @updatedAt

  tenant    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startedBy User                      @relation("PurchaseReceiptStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  items     PurchaseReceiptItem[]
  timeLogs  PurchaseReceiptTimeLog[]
  putaway   PutawaySession?
  inventoryMovements InventoryMovement[]

  @@unique([tenantId, accessKey], map: "purchase_receipt_sessions_tenant_access_key")
  @@index([tenantId, kind])
  @@index([tenantId])
  @@index([status])
  @@index([startedAt])
  @@map("purchase_receipt_sessions")
}

model PurchaseReceiptTimeLog {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  event     String
  createdAt DateTime @default(now())

  session PurchaseReceiptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@map("purchase_receipt_time_logs")
}

model PutawaySession {
  id                String               @id @default(cuid())
  purchaseReceiptId String               @unique
  status            PutawaySessionStatus @default(PENDING)
  assignedToId      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  purchaseReceipt PurchaseReceiptSession @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  assignedTo      User?                  @relation("PutawayAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  items           PutawayItem[]
  timeLogs        PutawayTimeLog[]
  inventoryMovements InventoryMovement[]

  @@index([status])
  @@map("putaway_sessions")
}

model PutawayTimeLog {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  event     String
  createdAt DateTime @default(now())

  session PutawaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
  @@map("putaway_time_logs")
}

model PutawayItem {
  id               String  @id @default(cuid())
  sessionId        String
  receiptItemId    String?
  productCode      String?
  description      String?
  barcode          String?
  quantityExpected Decimal @db.Decimal(12, 3)
  quantityStored   Decimal @default(0) @db.Decimal(12, 3)
  locationId       String?

  session  PutawaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  location Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@map("putaway_items")
}

model PurchaseReceiptItem {
  id               String  @id @default(cuid())
  sessionId        String
  lineNumber       Int
  tinyItemId       String?
  productCode      String?
  description      String?
  barcode          String?
  quantityExpected Decimal @db.Decimal(12, 3)
  quantityChecked  Decimal @default(0) @db.Decimal(12, 3)

  session PurchaseReceiptSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, lineNumber])
  @@index([sessionId])
  @@map("purchase_receipt_items")
}

/// Log de eventos de integração (ex.: webhook Tiny)
model IntegrationEventLog {
  id         String   @id @default(cuid())
  tenantId   String
  source     String
  eventType  String
  externalId String?
  status     String
  message    String?
  payload    Json?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, source, createdAt])
  @@map("integration_event_logs")
}

model PickWaveOrder {
  id      String @id @default(cuid())
  waveId  String
  orderId String

  wave  PickWave @relation(fields: [waveId], references: [id], onDelete: Cascade)
  order Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([waveId, orderId])
  @@unique([orderId])
  @@index([waveId])
  @@map("pick_wave_orders")
}

model PickWaveLine {
  id              String                 @id @default(cuid())
  waveId          String
  productId       String
  pickLocationId  String
  quantityTotal   Int
  quantityPicked  Int                    @default(0)
  sortStatus      PickWaveLineSortStatus @default(PENDING)
  pickedById      String?
  pickStartedAt   DateTime?
  pickCompletedAt DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  wave         PickWave             @relation(fields: [waveId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  pickLocation Location             @relation(fields: [pickLocationId], references: [id], onDelete: Restrict)
  pickedBy     User?                @relation("WaveLinePickedBy", fields: [pickedById], references: [id], onDelete: SetNull)
  allocations  PickWaveAllocation[]
  inventoryMovements InventoryMovement[]

  @@index([pickCompletedAt])

  @@unique([waveId, productId, pickLocationId])
  @@index([waveId, sortStatus])
  @@map("pick_wave_lines")
}

model PickWaveAllocation {
  id              String    @id @default(cuid())
  waveLineId      String
  orderItemId     String
  quantity        Int
  quantitySorted  Int       @default(0)
  sortedById      String?
  sortStartedAt   DateTime?
  sortCompletedAt DateTime?

  waveLine  PickWaveLine @relation(fields: [waveLineId], references: [id], onDelete: Cascade)
  orderItem OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  sortedBy  User?        @relation("WaveAllocSortedBy", fields: [sortedById], references: [id], onDelete: SetNull)

  @@unique([waveLineId, orderItemId])
  @@index([waveLineId])
  @@index([sortCompletedAt])
  @@map("pick_wave_allocations")
}

// -----------------------------------------------------------------------------
// ReplenishmentAssignment — aceite de reabastecimento por gôndola
// -----------------------------------------------------------------------------

model ReplenishmentAssignment {
  id              String                       @id @default(cuid())
  tenantId        String
  pickFaceId      String
  assignedToId    String
  status          ReplenishmentAssignmentStatus @default(OPEN)
  cargoTransferId String?                      @unique
  acceptedAt      DateTime                     @default(now())
  completedAt     DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pickFace      Location       @relation(fields: [pickFaceId], references: [id], onDelete: Cascade)
  assignedTo    User           @relation("ReplenishmentAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  cargoTransfer CargoTransfer? @relation(fields: [cargoTransferId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([pickFaceId, status])
  @@index([assignedToId, status])
  @@map("replenishment_assignments")
}
