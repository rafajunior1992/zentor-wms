{
  "name": "wms-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Warehouse Management System — monorepo",
  "scripts": {
    "dev": "pnpm --filter @wms/api --filter @wms/web --parallel dev",
    "dev:api": "pnpm --filter @wms/api dev",
    "dev:web": "pnpm --filter @wms/web dev",
    "dev:mobile": "pnpm --filter @wms/mobile dev",
    "dev:mobile:go": "pnpm --filter @wms/mobile dev:go",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @wms/api db:generate",
    "db:migrate": "pnpm --filter @wms/api db:migrate",
    "db:push": "pnpm --filter @wms/api db:push",
    "db:seed": "pnpm --filter @wms/api db:seed",
    "db:studio": "pnpm --filter @wms/api db:studio",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "teste-etiquetas-expedicao": "pnpm --filter @wms/api teste-etiquetas-expedicao",
    "cruzar-etiquetas": "pnpm --filter @wms/api cruzar-etiquetas"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "eas-cli": "16"
  }
}
